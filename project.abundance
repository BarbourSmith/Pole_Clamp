              "interpreterVersion": 1,
              "code": "/**\n * Hook Jaw, closed on a 29 mm pipe whose center is the origin; Z runs along the pipe.\n * Shape read from the photos: from the lower hinge a straight leg runs tangent into a\n * round section concentric with the pipe; where the round section ends the jaw kinks\n * outward into a straight fork that tapers to its tip. A center tongue carries the hinge\n * knuckle along the leg, and the full-width layers are notched to clear the body's hinge\n * plates. The fork's two prongs are split by a slot for the rod, with small lips at the tip.\n */\nfunction run(\n  pipeR: number = 14.5,      // bore radius: closes on a 29 mm pipe\n  wall: number = 6,          // leg and round-section wall\n  width: number = 30,        // along the pipe\n  tangentAngle: number = -65, // degrees, where the straight leg meets the bore\n  arcEnd: number = 30,       // degrees, where the round section ends and the fork kinks\n  kink: number = 44,         // outward kink of the fork from the arc's tangent, degrees\n  forkLength: number = 24,   // along the fork, from the kink to the tip\n  tipWall: number = 4,       // fork wall at the tip\n  tongueWidth: number = 10,\n  pinX: number = -7, pinY: number = -24, knuckleR: number = 6,\n  hingeClearance: number = 0.3, // gap around the body's hinge plates\n  slotWidth: number = 9,\n  slotBottom: number = 18,   // rod (8 mm) rests on this, centered 22 mm above the pipe\n  lipDepth: number = 1,      // how far each tip lip narrows the slot\n  lipLength: number = 3,\n): Assembly {\n  const outerR = pipeR + wall;\n  const rad = (d: number) => (d * Math.PI) / 180;\n  const polar = (r: number, d: number) => [r * Math.cos(rad(d)), r * Math.sin(rad(d))];\n  const add = (p: number[], v: number[], s: number) => [p[0] + v[0] * s, p[1] + v[1] * s];\n\n  // Round section: annular sector from the tangent point to the kink.\n  const pts: number[][] = [[0, 0]];\n  for (let i = 0; i <= 16; i++) pts.push(polar(60, tangentAngle + ((arcEnd - tangentAngle) * i) / 16));\n  let wedge = replicad.draw(pts[0]);\n  for (const p of pts.slice(1)) wedge = wedge.lineTo(p);\n  const arc = replicad.drawCircle(outerR).cut(replicad.drawCircle(pipeR)).intersect(wedge.close());\n\n  // Straight leg: tangent to the bore at tangentAngle, running back past the hinge pin.\n  const n = polar(1, tangentAngle);                 // outward normal at the tangent point\n  const t = [-n[1], n[0]];                          // along the bore, toward the arc\n  const T = polar(pipeR, tangentAngle);\n  const back = t[0] * (pinX - T[0]) + t[1] * (pinY - T[1]); // pin's position along the leg\n  const legStart = add(T, t, back);\n  const leg = replicad.draw(legStart).lineTo(T).lineTo(add(T, n, wall))\n    .lineTo(add(legStart, n, wall)).close();\n\n  // Fork: kinks outward from the arc's tangent and tapers from wall to tipWall.\n  const heading = arcEnd + 90 - kink;\n  const d = polar(1, heading);\n  const nf = [d[1], -d[0]];                         // across the fork, away from the pipe\n  const base = polar(pipeR, arcEnd);\n  const tip = add(base, d, forkLength);\n  const fork = replicad.draw(base).lineTo(tip).lineTo(add(tip, nf, tipWall))\n    .lineTo(add(base, nf, wall)).close();\n\n  // Full-width jaw, notched around the hinge so the body's plates clear it.\n  const plateClear = replicad.drawCircle(knuckleR + hingeClearance).translate(pinX, pinY)\n    .sketchOnPlane().extrude(width);\n  const full = arc.fuse(leg).fuse(fork).cut(replicad.drawCircle(pipeR))\n    .sketchOnPlane().extrude(width).cut(plateClear);\n\n  // Center tongue: the hinge knuckle plus the leg, so the knuckle stays joined to the jaw\n  // where the notch removes the outer layers.\n  const knuckle = replicad.drawCircle(knuckleR).translate(pinX, pinY);\n  const tongue = knuckle.fuse(leg).cut(replicad.drawCircle(pipeR))\n    .sketchOnPlane().extrude(tongueWidth).translate(0, 0, (width - tongueWidth) / 2);\n\n  // Slot between the prongs from slotBottom to the tip, narrowed by lips over the last\n  // lipLength (makeBaseBox is centered in X and Y).\n  const tipY = Math.max(tip[1], tip[1] + nf[1] * tipWall);\n  const slotX = tip[0];\n  const span = 30;\n  const lower = tipY - lipLength - slotBottom;\n  const slot = replicad.makeBaseBox(span, lower, slotWidth)\n    .translate(slotX, slotBottom + lower / 2, (width - slotWidth) / 2);\n  const lipGap = slotWidth - 2 * lipDepth;\n  const mouth = replicad.makeBaseBox(span, lipLength + 2, lipGap)\n    .translate(slotX, tipY - lipLength + (lipLength + 2) / 2, (width - lipGap) / 2);\n  return new Assembly({ geometry: full.fuse(tongue).cut(slot).cut(mouth) });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Hook Jaw, closed on a 29 mm pipe whose center is the origin; Z runs along the pipe.\n * Shape read from the photos: from the lower hinge a straight leg runs tangent into a\n * round section concentric with the pipe; where the round section ends the jaw kinks\n * outward into a straight fork that tapers to its tip. A center tongue carries the hinge\n * knuckle along the leg, and the full-width layers are notched to clear the body's hinge\n * plates. The fork's two prongs are split by a slot for the rod, with small lips at the tip.\n */\nfunction run(pipeR = 14.5, // bore radius: closes on a 29 mm pipe\nwall = 6, // leg and round-section wall\nwidth = 30, // along the pipe\ntangentAngle = -65, // degrees, where the straight leg meets the bore\narcEnd = 30, // degrees, where the round section ends and the fork kinks\nkink = 44, // outward kink of the fork from the arc's tangent, degrees\nforkLength = 24, // along the fork, from the kink to the tip\ntipWall = 4, // fork wall at the tip\ntongueWidth = 10, pinX = -7, pinY = -24, knuckleR = 6, hingeClearance = 0.3, // gap around the body's hinge plates\nslotWidth = 9, slotBottom = 18, // rod (8 mm) rests on this, centered 22 mm above the pipe\nlipDepth = 1, // how far each tip lip narrows the slot\nlipLength = 3) {\n    const outerR = pipeR + wall;\n    const rad = (d) => (d * Math.PI) / 180;\n    const polar = (r, d) => [r * Math.cos(rad(d)), r * Math.sin(rad(d))];\n    const add = (p, v, s) => [p[0] + v[0] * s, p[1] + v[1] * s];\n    // Round section: annular sector from the tangent point to the kink.\n    const pts = [[0, 0]];\n    for (let i = 0; i <= 16; i++)\n        pts.push(polar(60, tangentAngle + ((arcEnd - tangentAngle) * i) / 16));\n    let wedge = replicad.draw(pts[0]);\n    for (const p of pts.slice(1))\n        wedge = wedge.lineTo(p);\n    const arc = replicad.drawCircle(outerR).cut(replicad.drawCircle(pipeR)).intersect(wedge.close());\n    // Straight leg: tangent to the bore at tangentAngle, running back past the hinge pin.\n    const n = polar(1, tangentAngle); // outward normal at the tangent point\n    const t = [-n[1], n[0]]; // along the bore, toward the arc\n    const T = polar(pipeR, tangentAngle);\n    const back = t[0] * (pinX - T[0]) + t[1] * (pinY - T[1]); // pin's position along the leg\n    const legStart = add(T, t, back);\n    const leg = replicad.draw(legStart).lineTo(T).lineTo(add(T, n, wall))\n        .lineTo(add(legStart, n, wall)).close();\n    // Fork: kinks outward from the arc's tangent and tapers from wall to tipWall.\n    const heading = arcEnd + 90 - kink;\n    const d = polar(1, heading);\n    const nf = [d[1], -d[0]]; // across the fork, away from the pipe\n    const base = polar(pipeR, arcEnd);\n    const tip = add(base, d, forkLength);\n    const fork = replicad.draw(base).lineTo(tip).lineTo(add(tip, nf, tipWall))\n        .lineTo(add(base, nf, wall)).close();\n    // Full-width jaw, notched around the hinge so the body's plates clear it.\n    const plateClear = replicad.drawCircle(knuckleR + hingeClearance).translate(pinX, pinY)\n        .sketchOnPlane().extrude(width);\n    const full = arc.fuse(leg).fuse(fork).cut(replicad.drawCircle(pipeR))\n        .sketchOnPlane().extrude(width).cut(plateClear);\n    // Center tongue: the hinge knuckle plus the leg, so the knuckle stays joined to the jaw\n    // where the notch removes the outer layers.\n    const knuckle = replicad.drawCircle(knuckleR).translate(pinX, pinY);\n    const tongue = knuckle.fuse(leg).cut(replicad.drawCircle(pipeR))\n        .sketchOnPlane().extrude(tongueWidth).translate(0, 0, (width - tongueWidth) / 2);\n    // Slot between the prongs from slotBottom to the tip, narrowed by lips over the last\n    // lipLength (makeBaseBox is centered in X and Y).\n    const tipY = Math.max(tip[1], tip[1] + nf[1] * tipWall);\n    const slotX = tip[0];\n    const span = 30;\n    const lower = tipY - lipLength - slotBottom;\n    const slot = replicad.makeBaseBox(span, lower, slotWidth)\n        .translate(slotX, slotBottom + lower / 2, (width - slotWidth) / 2);\n    const lipGap = slotWidth - 2 * lipDepth;\n    const mouth = replicad.makeBaseBox(span, lipLength + 2, lipGap)\n        .translate(slotX, tipY - lipLength + (lipLength + 2) / 2, (width - lipGap) / 2);\n    return new Assembly({ geometry: full.fuse(tongue).cut(slot).cut(mouth) });\n}\n"
            }
