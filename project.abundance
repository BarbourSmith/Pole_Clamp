              "interpreterVersion": 1,
              "code": "/**\n * Clamp Body (cast aluminum), in mm. Pipe center at the origin, Z along the pipe, hinge\n * pins on a vertical line. Every outline point below was measured through the top-down\n * photo with its camera solved from the 1/2\" mat grid (1.8 px RMS), on the body's top face\n * 30 mm above the mat, so perspective and lens scale are taken out. The round seat is the\n * circle fitted to the seat edge (16.7 mm radius, 0.27 mm RMS); a 29 mm pipe rests against\n * its back, so its center sits seatOffset behind the pipe's.\n */\nconst OUTLINE: number[][] = [ // counterclockwise from the box's lower back corner\n  [-28.71, -13.2],  // box, lower back corner\n  [-17.94, -13.49], // end of the box's bottom edge\n  [-14.72, -16.78], // lower arm, outer edge\n  [-11.5, -20.07],\n  [-10.28, -20.82], // meets the lower knuckle\n  [-4.5, -14.42],   // lower arm inner edge, where it leaves the seat\n  [-6.52, -13.89],\n  [-14.55, -7.0],   // pocket's lower front corner\n  [-23.1, -7.0],    // pocket back\n  [-23.1, 7.0],\n  [-14.55, 7.0],    // pocket's upper front corner\n  [-5.53, 15.26],   // upper arm inner edge, where it leaves the seat\n  [-3.7, 16.9],     // (measured -3.48, 16.54; nudged inside the knuckle to avoid a sliver)\n  [-10.18, 22.31],  // upper arm, outer edge, meets the upper knuckle\n  [-11.86, 18.74],\n  [-17.07, 13.36],  // end of the box's top edge\n  [-28.71, 13.2],   // box, upper back corner\n];\n\nfunction run(\n  pinX: number = -5.65,      // both hinge pins, measured 42.9 mm apart\n  pinY: number = 21.46,      // upper pin at +pinY, lower at -pinY\n  knuckleR: number = 5.3,\n  seatR: number = 16.7,\n  seatOffset: number = 2.2,  // seat center behind (+X of) the pipe center: seatR - pipe radius\n  thickness: number = 30,    // along the pipe (listing 30, scan 28.5-28.7)\n  cornerR: number = 1.2,     // box's outer back corner radius, from the photo\n): Assembly {\n  let pen = replicad.draw(OUTLINE[0]);\n  for (const p of OUTLINE.slice(1)) pen = pen.lineTo(p);\n  const knuckles = replicad.drawCircle(knuckleR).translate(pinX, pinY)\n    .fuse(replicad.drawCircle(knuckleR).translate(pinX, -pinY));\n  const seat = replicad.drawCircle(seatR).translate(seatOffset, 0);\n  const body = pen.close().fuse(knuckles).cut(seat).sketchOnPlane().extrude(thickness);\n\n  // Round the box's two outer back corners as in the photo.\n  const corners = [OUTLINE[0], OUTLINE[OUTLINE.length - 1]];\n  const isCorner = (e: any) => {\n    const c = e.boundingBox.center;\n    return corners.some(([x, y]) => Math.abs(c[0] - x) < 0.01 && Math.abs(c[1] - y) < 0.01);\n  };\n  try {\n    return new Assembly({ geometry: body.fillet((e: any) => (isCorner(e) ? cornerR : null)) });\n  } catch (err) {\n    console.warn(\"Corner rounding failed; returning sharp corners:\", err);\n    return new Assembly({ geometry: body });\n  }\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Clamp Body (cast aluminum), in mm. Pipe center at the origin, Z along the pipe, hinge\n * pins on a vertical line. Every outline point below was measured through the top-down\n * photo with its camera solved from the 1/2\" mat grid (1.8 px RMS), on the body's top face\n * 30 mm above the mat, so perspective and lens scale are taken out. The round seat is the\n * circle fitted to the seat edge (16.7 mm radius, 0.27 mm RMS); a 29 mm pipe rests against\n * its back, so its center sits seatOffset behind the pipe's.\n */\nconst OUTLINE = [\n    [-28.71, -13.2], // box, lower back corner\n    [-17.94, -13.49], // end of the box's bottom edge\n    [-14.72, -16.78], // lower arm, outer edge\n    [-11.5, -20.07],\n    [-10.28, -20.82], // meets the lower knuckle\n    [-4.5, -14.42], // lower arm inner edge, where it leaves the seat\n    [-6.52, -13.89],\n    [-14.55, -7.0], // pocket's lower front corner\n    [-23.1, -7.0], // pocket back\n    [-23.1, 7.0],\n    [-14.55, 7.0], // pocket's upper front corner\n    [-5.53, 15.26], // upper arm inner edge, where it leaves the seat\n    [-3.7, 16.9], // (measured -3.48, 16.54; nudged inside the knuckle to avoid a sliver)\n    [-10.18, 22.31], // upper arm, outer edge, meets the upper knuckle\n    [-11.86, 18.74],\n    [-17.07, 13.36], // end of the box's top edge\n    [-28.71, 13.2], // box, upper back corner\n];\nfunction run(pinX = -5.65, // both hinge pins, measured 42.9 mm apart\npinY = 21.46, // upper pin at +pinY, lower at -pinY\nknuckleR = 5.3, seatR = 16.7, seatOffset = 2.2, // seat center behind (+X of) the pipe center: seatR - pipe radius\nthickness = 30, // along the pipe (listing 30, scan 28.5-28.7)\ncornerR = 1.2) {\n    let pen = replicad.draw(OUTLINE[0]);\n    for (const p of OUTLINE.slice(1))\n        pen = pen.lineTo(p);\n    const knuckles = replicad.drawCircle(knuckleR).translate(pinX, pinY)\n        .fuse(replicad.drawCircle(knuckleR).translate(pinX, -pinY));\n    const seat = replicad.drawCircle(seatR).translate(seatOffset, 0);\n    const body = pen.close().fuse(knuckles).cut(seat).sketchOnPlane().extrude(thickness);\n    // Round the box's two outer back corners as in the photo.\n    const corners = [OUTLINE[0], OUTLINE[OUTLINE.length - 1]];\n    const isCorner = (e) => {\n        const c = e.boundingBox.center;\n        return corners.some(([x, y]) => Math.abs(c[0] - x) < 0.01 && Math.abs(c[1] - y) < 0.01);\n    };\n    try {\n        return new Assembly({ geometry: body.fillet((e) => (isCorner(e) ? cornerR : null)) });\n    }\n    catch (err) {\n        console.warn(\"Corner rounding failed; returning sharp corners:\", err);\n        return new Assembly({ geometry: body });\n    }\n}\n"
            },
