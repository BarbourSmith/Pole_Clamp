            {
              "atomType": "Molecule",
              "x": 0.2,
              "y": 0.6,
              "uniqueID": "id-273",
              "name": "Spring",
              "topLevel": false,
              "allAtoms": [
                {
                  "atomType": "Code",
                  "x": 0.3,
                  "y": 0.5,
                  "uniqueID": "id-1165",
                  "ioValues": [
                    {
                      "name": "coilOD",
                      "ioValue": 11
                    },
                    {
                      "name": "wireD",
                      "ioValue": 1.2
                    },
                    {
                      "name": "length",
                      "ioValue": 11.8
                    },
                    {
                      "name": "turns",
                      "ioValue": 6
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Compression spring around the clamping rod: round wire swept along a helix, axis on Z\n * from z = 0 to length. Falls back to stacked rings if the sweep fails.\n */\nfunction run(\n  coilOD: number = 11,   // outer diameter, measured from the photos\n  wireD: number = 1.2,\n  length: number = 15,   // compressed length, nut to fork\n  turns: number = 6,\n): Assembly {\n  const R = (coilOD - wireD) / 2;\n  const travel = length - wireD;\n  const pitch = travel / turns;\n  let coil;\n  try {\n    const spine = replicad.makeHelix(pitch, travel, R);\n    const profile = replicad.drawCircle(wireD / 2).sketchOnPlane(\"XZ\", [R, 0, 0]);\n    coil = replicad.genericSweep(profile.wire, spine, { frenet: true }, false);\n  } catch (e) {\n    console.warn(\"Helix sweep failed, using rings:\", e);\n    const ring = replicad.drawCircle(wireD / 2).translate(R, 0).sketchOnPlane(\"XZ\").revolve();\n    coil = ring;\n    for (let i = 1; i <= turns; i++) coil = coil.fuse(ring.clone().translate(0, 0, pitch * i));\n  }\n  return new Assembly({ geometry: coil.translate(0, 0, wireD / 2) });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Compression spring around the clamping rod: round wire swept along a helix, axis on Z\n * from z = 0 to length. Falls back to stacked rings if the sweep fails.\n */\nfunction run(coilOD = 11, // outer diameter, measured from the photos\nwireD = 1.2, length = 15, // compressed length, nut to fork\nturns = 6) {\n    const R = (coilOD - wireD) / 2;\n    const travel = length - wireD;\n    const pitch = travel / turns;\n    let coil;\n    try {\n        const spine = replicad.makeHelix(pitch, travel, R);\n        const profile = replicad.drawCircle(wireD / 2).sketchOnPlane(\"XZ\", [R, 0, 0]);\n        coil = replicad.genericSweep(profile.wire, spine, { frenet: true }, false);\n    }\n    catch (e) {\n        console.warn(\"Helix sweep failed, using rings:\", e);\n        const ring = replicad.drawCircle(wireD / 2).translate(R, 0).sketchOnPlane(\"XZ\").revolve();\n        coil = ring;\n        for (let i = 1; i <= turns; i++)\n            coil = coil.fuse(ring.clone().translate(0, 0, pitch * i));\n    }\n    return new Assembly({ geometry: coil.translate(0, 0, wireD / 2) });\n}\n"
