              "interpreterVersion": 1,
              "code": "/**\n * Clamp Body (cast aluminum), in mm. Pipe center at the origin, Z along the pipe; the\n * body's side of the opening is a round seat matching the jaw, so a 29 mm pipe is held all\n * the way round. Box, arms and hinge positions measured from the top-down photo on the\n * 1/2\" mat. The box's sharp outer corners are rounded like the casting.\n */\nfunction run(\n  boxBack: number = -31.5,   // outer face of the bolt box\n  boxHalfHeight: number = 14,\n  pocketBack: number = -25,  // inner face of the bolt box (6.5 mm wall)\n  pocketHalfHeight: number = 7.25,\n  pocketFront: number = -14.5, // where the pocket opens into the seat\n  seatR: number = 14.5,      // round seat: closes on a 29 mm pipe, same as the jaw\n  vAngle: number = 36.6,     // slope of the arms' inner edges, degrees\n  upperPinX: number = -5, upperPinY: number = 22, upperKnuckleR: number = 5.5,\n  lowerPinX: number = -7, lowerPinY: number = -24, lowerKnuckleR: number = 6,\n  thickness: number = 30,    // along the pipe (listing 30, scan 28.5-28.7)\n  cornerR: number = 1.5,     // casting corner radius\n): Assembly {\n  const t = Math.tan((vAngle * Math.PI) / 180);\n  const vy = (x: number) => pocketHalfHeight + t * (x - pocketFront);\n  // Solid out to the arms, then the seat circle is cut out of it. Arm corners sit well\n  // inside the knuckle circles so the outline crosses them cleanly.\n  const outline = replicad\n    .draw([boxBack, -boxHalfHeight])\n    .lineTo([-17, -boxHalfHeight])\n    .lineTo([lowerPinX - 3, lowerPinY - 4.8])\n    .lineTo([lowerPinX + 5.8, lowerPinY - 1])\n    .lineTo([-0.7, -vy(-0.7)])\n    .lineTo([-0.7, -pocketHalfHeight - 1])\n    .lineTo([pocketFront, -pocketHalfHeight])\n    .lineTo([pocketBack, -pocketHalfHeight])\n    .lineTo([pocketBack, pocketHalfHeight])\n    .lineTo([pocketFront, pocketHalfHeight])\n    .lineTo([-1, pocketHalfHeight + 1])\n    .lineTo([-1, vy(-1)])\n    .lineTo([upperPinX + 4.5, upperPinY + 1])\n    .lineTo([upperPinX - 4, upperPinY + 3.5])\n    .lineTo([-18, boxHalfHeight])\n    .lineTo([boxBack, boxHalfHeight])\n    .close();\n  const knuckles = replicad\n    .drawCircle(upperKnuckleR).translate(upperPinX, upperPinY)\n    .fuse(replicad.drawCircle(lowerKnuckleR).translate(lowerPinX, lowerPinY));\n  const seat = replicad.drawCircle(seatR);\n  const body = outline.fuse(knuckles).cut(seat).sketchOnPlane().extrude(thickness);\n\n  // Round the box's two outer back corners, the sharp corners visible in the photos. The\n  // pocket's inner corners stay sharp so the bolt head seats flat against the back wall.\n  const corners = [[boxBack, boxHalfHeight], [boxBack, -boxHalfHeight]];\n  const isCorner = (e: any) => {\n    const c = e.boundingBox.center;\n    return corners.some(([x, y]) => Math.abs(c[0] - x) < 0.01 && Math.abs(c[1] - y) < 0.01);\n  };\n  try {\n    return new Assembly({ geometry: body.fillet((e: any) => (isCorner(e) ? cornerR : null)) });\n  } catch (err) {\n    console.warn(\"Corner rounding failed; returning sharp corners:\", err);\n    return new Assembly({ geometry: body });\n  }\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Clamp Body (cast aluminum), in mm. Pipe center at the origin, Z along the pipe; the\n * body's side of the opening is a round seat matching the jaw, so a 29 mm pipe is held all\n * the way round. Box, arms and hinge positions measured from the top-down photo on the\n * 1/2\" mat. The box's sharp outer corners are rounded like the casting.\n */\nfunction run(boxBack = -31.5, // outer face of the bolt box\nboxHalfHeight = 14, pocketBack = -25, // inner face of the bolt box (6.5 mm wall)\npocketHalfHeight = 7.25, pocketFront = -14.5, // where the pocket opens into the seat\nseatR = 14.5, // round seat: closes on a 29 mm pipe, same as the jaw\nvAngle = 36.6, // slope of the arms' inner edges, degrees\nupperPinX = -5, upperPinY = 22, upperKnuckleR = 5.5, lowerPinX = -7, lowerPinY = -24, lowerKnuckleR = 6, thickness = 30, // along the pipe (listing 30, scan 28.5-28.7)\ncornerR = 1.5) {\n    const t = Math.tan((vAngle * Math.PI) / 180);\n    const vy = (x) => pocketHalfHeight + t * (x - pocketFront);\n    // Solid out to the arms, then the seat circle is cut out of it. Arm corners sit well\n    // inside the knuckle circles so the outline crosses them cleanly.\n    const outline = replicad\n        .draw([boxBack, -boxHalfHeight])\n        .lineTo([-17, -boxHalfHeight])\n        .lineTo([lowerPinX - 3, lowerPinY - 4.8])\n        .lineTo([lowerPinX + 5.8, lowerPinY - 1])\n        .lineTo([-0.7, -vy(-0.7)])\n        .lineTo([-0.7, -pocketHalfHeight - 1])\n        .lineTo([pocketFront, -pocketHalfHeight])\n        .lineTo([pocketBack, -pocketHalfHeight])\n        .lineTo([pocketBack, pocketHalfHeight])\n        .lineTo([pocketFront, pocketHalfHeight])\n        .lineTo([-1, pocketHalfHeight + 1])\n        .lineTo([-1, vy(-1)])\n        .lineTo([upperPinX + 4.5, upperPinY + 1])\n        .lineTo([upperPinX - 4, upperPinY + 3.5])\n        .lineTo([-18, boxHalfHeight])\n        .lineTo([boxBack, boxHalfHeight])\n        .close();\n    const knuckles = replicad\n        .drawCircle(upperKnuckleR).translate(upperPinX, upperPinY)\n        .fuse(replicad.drawCircle(lowerKnuckleR).translate(lowerPinX, lowerPinY));\n    const seat = replicad.drawCircle(seatR);\n    const body = outline.fuse(knuckles).cut(seat).sketchOnPlane().extrude(thickness);\n    // Round the box's two outer back corners, the sharp corners visible in the photos. The\n    // pocket's inner corners stay sharp so the bolt head seats flat against the back wall.\n    const corners = [[boxBack, boxHalfHeight], [boxBack, -boxHalfHeight]];\n    const isCorner = (e) => {\n        const c = e.boundingBox.center;\n        return corners.some(([x, y]) => Math.abs(c[0] - x) < 0.01 && Math.abs(c[1] - y) < 0.01);\n    };\n    try {\n        return new Assembly({ geometry: body.fillet((e) => (isCorner(e) ? cornerR : null)) });\n    }\n    catch (err) {\n        console.warn(\"Corner rounding failed; returning sharp corners:\", err);\n        return new Assembly({ geometry: body });\n    }\n}\n"
            },
