              "interpreterVersion": 1,
              "code": "/**\n * Clamp Body outline (top view), in mm. Pipe center at the origin; the V faces\n * are tangent to a 29 mm pipe. Measured from the top-down photo on the 1/2\" mat.\n */\nfunction run(\n  boxBack: number = -31.5,   // outer face of the bolt box\n  boxHalfHeight: number = 14,\n  pocketBack: number = -25,  // inner face of the bolt box (6.5 mm wall)\n  pocketHalfHeight: number = 7.25,\n  pocketFront: number = -14.5, // where the V faces start\n  vAngle: number = 36.6,     // V face angle from the X axis, degrees\n  upperPinX: number = -5, upperPinY: number = 22, upperKnuckleR: number = 5.5,\n  lowerPinX: number = -7, lowerPinY: number = -24, lowerKnuckleR: number = 6,\n): Assembly {\n  const t = Math.tan((vAngle * Math.PI) / 180);\n  const vy = (x: number) => pocketHalfHeight + t * (x - pocketFront);\n  // Arm corners sit well inside the knuckle circles so the outline crosses them cleanly.\n  const outline = replicad\n    .draw([boxBack, -boxHalfHeight])\n    .lineTo([-17, -boxHalfHeight])\n    .lineTo([lowerPinX - 3, lowerPinY - 4.8])\n    .lineTo([lowerPinX + 5.8, lowerPinY - 1])\n    .lineTo([-0.7, -vy(-0.7)])\n    .lineTo([pocketFront, -pocketHalfHeight])\n    .lineTo([pocketBack, -pocketHalfHeight])\n    .lineTo([pocketBack, pocketHalfHeight])\n    .lineTo([pocketFront, pocketHalfHeight])\n    .lineTo([-1, vy(-1)])\n    .lineTo([upperPinX + 4.5, upperPinY + 1])\n    .lineTo([upperPinX - 4, upperPinY + 3.5])\n    .lineTo([-18, boxHalfHeight])\n    .lineTo([boxBack, boxHalfHeight])\n    .close();\n  const knuckles = replicad\n    .drawCircle(upperKnuckleR).translate(upperPinX, upperPinY)\n    .fuse(replicad.drawCircle(lowerKnuckleR).translate(lowerPinX, lowerPinY));\n  return new Assembly({ geometry: outline.fuse(knuckles) });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Clamp Body outline (top view), in mm. Pipe center at the origin; the V faces\n * are tangent to a 29 mm pipe. Measured from the top-down photo on the 1/2\" mat.\n */\nfunction run(boxBack = -31.5, // outer face of the bolt box\nboxHalfHeight = 14, pocketBack = -25, // inner face of the bolt box (6.5 mm wall)\npocketHalfHeight = 7.25, pocketFront = -14.5, // where the V faces start\nvAngle = 36.6, // V face angle from the X axis, degrees\nupperPinX = -5, upperPinY = 22, upperKnuckleR = 5.5, lowerPinX = -7, lowerPinY = -24, lowerKnuckleR = 6) {\n    const t = Math.tan((vAngle * Math.PI) / 180);\n    const vy = (x) => pocketHalfHeight + t * (x - pocketFront);\n    // Arm corners sit well inside the knuckle circles so the outline crosses them cleanly.\n    const outline = replicad\n        .draw([boxBack, -boxHalfHeight])\n        .lineTo([-17, -boxHalfHeight])\n        .lineTo([lowerPinX - 3, lowerPinY - 4.8])\n        .lineTo([lowerPinX + 5.8, lowerPinY - 1])\n        .lineTo([-0.7, -vy(-0.7)])\n        .lineTo([pocketFront, -pocketHalfHeight])\n        .lineTo([pocketBack, -pocketHalfHeight])\n        .lineTo([pocketBack, pocketHalfHeight])\n        .lineTo([pocketFront, pocketHalfHeight])\n        .lineTo([-1, vy(-1)])\n        .lineTo([upperPinX + 4.5, upperPinY + 1])\n        .lineTo([upperPinX - 4, upperPinY + 3.5])\n        .lineTo([-18, boxHalfHeight])\n        .lineTo([boxBack, boxHalfHeight])\n        .close();\n    const knuckles = replicad\n        .drawCircle(upperKnuckleR).translate(upperPinX, upperPinY)\n        .fuse(replicad.drawCircle(lowerKnuckleR).translate(lowerPinX, lowerPinY));\n    return new Assembly({ geometry: outline.fuse(knuckles) });\n}\n"
