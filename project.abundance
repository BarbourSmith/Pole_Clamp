              ],
              "interpreterVersion": 1,
              "code": "/**\n * Hook Jaw, closed on a 29 mm pipe whose center is the origin; Z runs along the pipe.\n * Full-width arc from the bottom of the pipe to its right side, a straight fork up the\n * right side that takes the clamping rod, and a narrow tongue back to the lower hinge pin.\n */\nfunction run(\n  pipeR: number = 14.5,      // inner radius: closes on a 29 mm pipe\n  wall: number = 6,\n  width: number = 30,        // along the pipe\n  arcStart: number = -85,    // degrees, where the full-width arc begins\n  tongueStart: number = -125,\n  tongueWidth: number = 10,\n  pinX: number = -7, pinY: number = -24, knuckleR: number = 6,\n  forkTop: number = 28,      // top of the fork above the pipe center\n  slotWidth: number = 9,\n  slotBottom: number = 18,   // rod (8 mm) rests on this, centered 22 mm above the pipe\n): Assembly {\n  const outerR = pipeR + wall;\n  const rad = (d: number) => (d * Math.PI) / 180;\n  // Annular sector between two angles (degrees), as a drawing.\n  const sector = (a0: number, a1: number) => {\n    const pts: number[][] = [[0, 0]];\n    for (let i = 0; i <= 12; i++) {\n      const a = rad(a0 + ((a1 - a0) * i) / 12);\n      pts.push([60 * Math.cos(a), 60 * Math.sin(a)]);\n    }\n    let wedge = replicad.draw(pts[0]);\n    for (const p of pts.slice(1)) wedge = wedge.lineTo(p);\n    return replicad.drawCircle(outerR).cut(replicad.drawCircle(pipeR)).intersect(wedge.close());\n  };\n\n  const forkWall = replicad.drawRectangle(wall, forkTop).translate(pipeR + wall / 2, forkTop / 2);\n  const full = sector(arcStart, 0).fuse(forkWall).sketchOnPlane().extrude(width);\n\n  // Hinge tongue: knuckle around the pin, joined to the arc.\n  const knuckle = replicad.drawCircle(knuckleR).translate(pinX, pinY);\n  const web = replicad.draw([pinX - knuckleR * 0.7, pinY + knuckleR * 0.7])\n    .lineTo([outerR * Math.cos(rad(tongueStart)), outerR * Math.sin(rad(tongueStart))])\n    .lineTo([pipeR * Math.cos(rad(tongueStart)), pipeR * Math.sin(rad(tongueStart))])\n    .lineTo([pipeR * Math.cos(rad(arcStart)), pipeR * Math.sin(rad(arcStart))])\n    .lineTo([outerR * Math.cos(rad(arcStart)), outerR * Math.sin(rad(arcStart))])\n    .lineTo([pinX + knuckleR * 0.9, pinY - knuckleR * 0.4])\n    .close()\n    .cut(replicad.drawCircle(pipeR));\n  const tongue = sector(tongueStart, arcStart).fuse(knuckle).fuse(web)\n    .sketchOnPlane().extrude(tongueWidth).translate(0, 0, (width - tongueWidth) / 2);\n\n  // Open-ended slot in the fork for the rod (makeBaseBox is centered in X and Y).\n  const slot = replicad.makeBaseBox(wall + 2, forkTop, slotWidth)\n    .translate(pipeR + wall / 2, slotBottom + forkTop / 2, (width - slotWidth) / 2);\n  const jaw = full.fuse(tongue).cut(slot);\n  return new Assembly({ geometry: jaw });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Hook Jaw, closed on a 29 mm pipe whose center is the origin; Z runs along the pipe.\n * Full-width arc from the bottom of the pipe to its right side, a straight fork up the\n * right side that takes the clamping rod, and a narrow tongue back to the lower hinge pin.\n */\nfunction run(pipeR = 14.5, // inner radius: closes on a 29 mm pipe\nwall = 6, width = 30, // along the pipe\narcStart = -85, // degrees, where the full-width arc begins\ntongueStart = -125, tongueWidth = 10, pinX = -7, pinY = -24, knuckleR = 6, forkTop = 28, // top of the fork above the pipe center\nslotWidth = 9, slotBottom = 18) {\n    const outerR = pipeR + wall;\n    const rad = (d) => (d * Math.PI) / 180;\n    // Annular sector between two angles (degrees), as a drawing.\n    const sector = (a0, a1) => {\n        const pts = [[0, 0]];\n        for (let i = 0; i <= 12; i++) {\n            const a = rad(a0 + ((a1 - a0) * i) / 12);\n            pts.push([60 * Math.cos(a), 60 * Math.sin(a)]);\n        }\n        let wedge = replicad.draw(pts[0]);\n        for (const p of pts.slice(1))\n            wedge = wedge.lineTo(p);\n        return replicad.drawCircle(outerR).cut(replicad.drawCircle(pipeR)).intersect(wedge.close());\n    };\n    const forkWall = replicad.drawRectangle(wall, forkTop).translate(pipeR + wall / 2, forkTop / 2);\n    const full = sector(arcStart, 0).fuse(forkWall).sketchOnPlane().extrude(width);\n    // Hinge tongue: knuckle around the pin, joined to the arc.\n    const knuckle = replicad.drawCircle(knuckleR).translate(pinX, pinY);\n    const web = replicad.draw([pinX - knuckleR * 0.7, pinY + knuckleR * 0.7])\n        .lineTo([outerR * Math.cos(rad(tongueStart)), outerR * Math.sin(rad(tongueStart))])\n        .lineTo([pipeR * Math.cos(rad(tongueStart)), pipeR * Math.sin(rad(tongueStart))])\n        .lineTo([pipeR * Math.cos(rad(arcStart)), pipeR * Math.sin(rad(arcStart))])\n        .lineTo([outerR * Math.cos(rad(arcStart)), outerR * Math.sin(rad(arcStart))])\n        .lineTo([pinX + knuckleR * 0.9, pinY - knuckleR * 0.4])\n        .close()\n        .cut(replicad.drawCircle(pipeR));\n    const tongue = sector(tongueStart, arcStart).fuse(knuckle).fuse(web)\n        .sketchOnPlane().extrude(tongueWidth).translate(0, 0, (width - tongueWidth) / 2);\n    // Open-ended slot in the fork for the rod (makeBaseBox is centered in X and Y).\n    const slot = replicad.makeBaseBox(wall + 2, forkTop, slotWidth)\n        .translate(pipeR + wall / 2, slotBottom + forkTop / 2, (width - slotWidth) / 2);\n    const jaw = full.fuse(tongue).cut(slot);\n    return new Assembly({ geometry: jaw });\n}\n"
            }
