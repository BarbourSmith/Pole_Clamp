                    },
                    {
                      "name": "rootWidth",
                      "ioValue": 12.5
                    },
                    {
                      "name": "tipWidth",
                      "ioValue": 7
                    },
                    {
                      "name": "angle",
                      "ioValue": -95
                    },
                    {
                      "name": "curl",
                      "ioValue": 4
                    }
                  ],
                  "interpreterVersion": 1,
                  "code": "/**\n * Cam lever outline (top view), in mm: a round boss around the pivot barrel and a\n * handle that tapers to a slightly bulbous rounded tip with an outward curl, as in the photos.\n */\nfunction run(\n  pivotX: number = 37.5, pivotY: number = 22,\n  bossR: number = 10,\n  handleLength: number = 65, // pivot center to tip center\n  rootWidth: number = 12.5,\n  tipWidth: number = 7,\n  angle: number = -95,       // handle direction, degrees from +X (closed: pointing down)\n  curl: number = 4,          // sideways bow of the handle toward its tip\n): Assembly {\n  const a = (angle * Math.PI) / 180;\n  const d = [Math.cos(a), Math.sin(a)];\n  const n = [-d[1], d[0]];\n  const at = (s: number, off: number) => {\n    const bow = curl * (s / handleLength) ** 2;\n    return [pivotX + d[0] * s + n[0] * (off + bow), pivotY + d[1] * s + n[1] * (off + bow)];\n  };\n  const w = (s: number) => rootWidth + (tipWidth - rootWidth) * (s / handleLength);\n  const steps = 10;\n  let pen = replicad.draw(at(0, w(0) / 2));\n  for (let i = 1; i <= steps; i++) {\n    const s = (handleLength * i) / steps;\n    pen = pen.lineTo(at(s, w(s) / 2));\n  }\n  for (let i = steps; i >= 0; i--) {\n    const s = (handleLength * i) / steps;\n    pen = pen.lineTo(at(s, -w(s) / 2));\n  }\n  const handle = pen.close();\n  const tip = at(handleLength, 0);\n  // Tip knob a little wider than the handle so its circle isn't tangent to the sides.\n  const outline = handle\n    .fuse(replicad.drawCircle(bossR).translate(pivotX, pivotY))\n    .fuse(replicad.drawCircle(tipWidth / 2 + 0.6).translate(tip[0], tip[1]));\n  return new Assembly({ geometry: outline });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Cam lever outline (top view), in mm: a round boss around the pivot barrel and a\n * handle that tapers to a slightly bulbous rounded tip with an outward curl, as in the photos.\n */\nfunction run(pivotX = 37.5, pivotY = 22, bossR = 10, handleLength = 65, // pivot center to tip center\nrootWidth = 12.5, tipWidth = 7, angle = -95, // handle direction, degrees from +X (closed: pointing down)\ncurl = 4) {\n    const a = (angle * Math.PI) / 180;\n    const d = [Math.cos(a), Math.sin(a)];\n    const n = [-d[1], d[0]];\n    const at = (s, off) => {\n        const bow = curl * (s / handleLength) ** 2;\n        return [pivotX + d[0] * s + n[0] * (off + bow), pivotY + d[1] * s + n[1] * (off + bow)];\n    };\n    const w = (s) => rootWidth + (tipWidth - rootWidth) * (s / handleLength);\n    const steps = 10;\n    let pen = replicad.draw(at(0, w(0) / 2));\n    for (let i = 1; i <= steps; i++) {\n        const s = (handleLength * i) / steps;\n        pen = pen.lineTo(at(s, w(s) / 2));\n    }\n    for (let i = steps; i >= 0; i--) {\n        const s = (handleLength * i) / steps;\n        pen = pen.lineTo(at(s, -w(s) / 2));\n    }\n    const handle = pen.close();\n    const tip = at(handleLength, 0);\n    // Tip knob a little wider than the handle so its circle isn't tangent to the sides.\n    const outline = handle\n        .fuse(replicad.drawCircle(bossR).translate(pivotX, pivotY))\n        .fuse(replicad.drawCircle(tipWidth / 2 + 0.6).translate(tip[0], tip[1]));\n    return new Assembly({ geometry: outline });\n}\n"
                },
