                  "interpreterVersion": 1,
                  "code": "/**\n * Cam lever outline (top view), in mm: a round boss around the pivot barrel and a slender\n * handle traced from the top-down photo. Along the handle (s, from the pivot) the photo\n * gives its centerline offset (+ is to the left looking from pivot to tip) and its width:\n * it bows left near the root, crosses over, bows right, then the tip turns back up.\n */\nconst CENTER: number[][] = [ // [s, offset] for a 65 mm handle\n  [0, 0], [12, 2.5], [22, 3.0], [32, 2.5], [42, 0.5], [52, -2.2], [58, -2.8], [62, -1.8], [65, 0.5],\n];\nconst WIDTH: number[][] = [ // [s, width]\n  [0, 14], [12, 10], [22, 7.4], [32, 5.5], [42, 3.9], [52, 3.7], [58, 3.6], [65, 3.2],\n];\n\nfunction run(\n  pivotX: number = 39.4, pivotY: number = 22,\n  bossR: number = 9.5,\n  handleLength: number = 65, // pivot center to tip\n  angle: number = -95,       // pivot-to-tip direction, degrees from +X (closed: pointing down)\n): Assembly {\n  const k = handleLength / 65;\n  const lerp = (table: number[][], s: number) => {\n    for (let i = 1; i < table.length; i++) {\n      const [s0, v0] = table[i - 1];\n      const [s1, v1] = table[i];\n      if (s <= s1 * k) return v0 + ((v1 - v0) * (s - s0 * k)) / ((s1 - s0) * k);\n    }\n    return table[table.length - 1][1];\n  };\n  const a = (angle * Math.PI) / 180;\n  const d = [Math.cos(a), Math.sin(a)];\n  const n = [-d[1], d[0]];\n  const at = (s: number, off: number) =>\n    [pivotX + d[0] * s + n[0] * off, pivotY + d[1] * s + n[1] * off];\n\n  const steps = 26;\n  const ss = Array.from({ length: steps + 1 }, (_, i) => (handleLength * i) / steps);\n  let pen = replicad.draw(at(0, lerp(CENTER, 0) + lerp(WIDTH, 0) / 2));\n  for (const s of ss.slice(1)) pen = pen.lineTo(at(s, lerp(CENTER, s) + lerp(WIDTH, s) / 2));\n  for (const s of [...ss].reverse()) pen = pen.lineTo(at(s, lerp(CENTER, s) - lerp(WIDTH, s) / 2));\n  const handle = pen.close();\n\n  // Rounded tip a little wider than the handle so it isn't tangent to the sides.\n  const tipR = lerp(WIDTH, handleLength) / 2 + 0.4;\n  const tip = at(handleLength, lerp(CENTER, handleLength));\n  const outline = handle\n    .fuse(replicad.drawCircle(bossR).translate(pivotX, pivotY))\n    .fuse(replicad.drawCircle(tipR).translate(tip[0], tip[1]));\n  return new Assembly({ geometry: outline });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Cam lever outline (top view), in mm: a round boss around the pivot barrel and a slender\n * handle traced from the top-down photo. Along the handle (s, from the pivot) the photo\n * gives its centerline offset (+ is to the left looking from pivot to tip) and its width:\n * it bows left near the root, crosses over, bows right, then the tip turns back up.\n */\nconst CENTER = [\n    [0, 0], [12, 2.5], [22, 3.0], [32, 2.5], [42, 0.5], [52, -2.2], [58, -2.8], [62, -1.8], [65, 0.5],\n];\nconst WIDTH = [\n    [0, 14], [12, 10], [22, 7.4], [32, 5.5], [42, 3.9], [52, 3.7], [58, 3.6], [65, 3.2],\n];\nfunction run(pivotX = 39.4, pivotY = 22, bossR = 9.5, handleLength = 65, // pivot center to tip\nangle = -95) {\n    const k = handleLength / 65;\n    const lerp = (table, s) => {\n        for (let i = 1; i < table.length; i++) {\n            const [s0, v0] = table[i - 1];\n            const [s1, v1] = table[i];\n            if (s <= s1 * k)\n                return v0 + ((v1 - v0) * (s - s0 * k)) / ((s1 - s0) * k);\n        }\n        return table[table.length - 1][1];\n    };\n    const a = (angle * Math.PI) / 180;\n    const d = [Math.cos(a), Math.sin(a)];\n    const n = [-d[1], d[0]];\n    const at = (s, off) => [pivotX + d[0] * s + n[0] * off, pivotY + d[1] * s + n[1] * off];\n    const steps = 26;\n    const ss = Array.from({ length: steps + 1 }, (_, i) => (handleLength * i) / steps);\n    let pen = replicad.draw(at(0, lerp(CENTER, 0) + lerp(WIDTH, 0) / 2));\n    for (const s of ss.slice(1))\n        pen = pen.lineTo(at(s, lerp(CENTER, s) + lerp(WIDTH, s) / 2));\n    for (const s of [...ss].reverse())\n        pen = pen.lineTo(at(s, lerp(CENTER, s) - lerp(WIDTH, s) / 2));\n    const handle = pen.close();\n    // Rounded tip a little wider than the handle so it isn't tangent to the sides.\n    const tipR = lerp(WIDTH, handleLength) / 2 + 0.4;\n    const tip = at(handleLength, lerp(CENTER, handleLength));\n    const outline = handle\n        .fuse(replicad.drawCircle(bossR).translate(pivotX, pivotY))\n        .fuse(replicad.drawCircle(tipR).translate(tip[0], tip[1]));\n    return new Assembly({ geometry: outline });\n}\n"
                },
